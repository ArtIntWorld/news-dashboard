# Copy to .env and adjust. Every setting has a default; these are the defaults.

CACHE_FRESH_MINUTES=30
CACHE_STALE_HOURS=6
CACHE_MAX_ENTRIES=1000
EMPTY_RESULT_TTL_MINUTES=5

PREWARM_COUNTRIES=IN,US,CA
PREWARM_INTERVAL_MINUTES=30
PREWARM_PAUSE_SECONDS=1

FEED_CONNECT_TIMEOUT_MS=3000
FEED_READ_TIMEOUT_MS=5000
MAX_ARTICLE_AGE_DAYS=7

BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_SECONDS=120

RATE_LIMIT_PER_MINUTE=60

# Production only: the frontend origin allowed by CORS. Leave unset in development
# (the Vite proxy makes requests same-origin).
# ALLOWED_ORIGIN=https://news.example.com

# Optional MySQL history. Leave unset to run without a database.
# DB_URL=mysql+pymysql://news:secret@localhost:3306/newsdb

LOG_LEVEL=INFO
